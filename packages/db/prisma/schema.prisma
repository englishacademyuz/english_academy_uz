generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum StudentStatus {
  ACTIVE
  PAUSED
  INACTIVE
  COMPLETED
  LEFT
}

enum GroupStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  ENDED
}

enum EnrollmentEndReason {
  GROUP_CHANGE
  STUDENT_LEFT
  COMPLETED
  OTHER
}

enum LessonMaterialType {
  PDF
  DOCUMENT
  IMAGE
  VIDEO
  AUDIO
  LINK
  TEXT
}

enum HomeworkResultStatus {
  COMPLETED
  NOT_COMPLETED
}

// A student's photos of their homework (only in groups that allow it): waiting
// for the teacher, checked, or sent back to be redone and handed in again.
enum HomeworkSubmissionStatus {
  SUBMITTED
  CHECKED
  RETURNED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssessmentType {
  WEEKLY
  MONTHLY
  GENERAL
  CUSTOM
}

// How often a category is meant to be graded. DAILY categories are always
// open for entry on every lesson day; WEEKLY/MONTHLY categories are only
// graded when a teacher explicitly opens that period's round (the existing
// "add marking" flow), so they don't clutter every single lesson day.
enum AssessmentCategoryCadence {
  DAILY
  WEEKLY
  MONTHLY
}

// Closed is not stored: a SENT quiz is closed once its deadline has passed
// (closing early just moves the deadline to now).
enum QuizStatus {
  DRAFT
  SENT
}

enum PaymentStatus {
  DEBT
  PARTIAL
  PAID
}

// Who wrote a chat message: someone in the student's family (any of their linked
// Telegram chats -- the student or a parent) or a member of staff (Admin/Teacher).
enum ChatSender {
  FAMILY
  STAFF
}

enum PointActivityType {
  HOMEWORK
  PARTICIPATION
  QUIZ
  ASSESSMENT
  ATTENDANCE
  OTHER
}

// One authenticated identity. Admin/Teacher log in with username+password;
// students reach the Telegram bot through TelegramLink, not through a User.
model User {
  id           String   @id @default(cuid())
  role         Role
  username     String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student?
  teacher Teacher?

  chatMessages      ChatMessage[]
  conversationReads ConversationRead[]

  @@map("users")
}

model Student {
  id                String        @id @default(cuid())
  firstName         String
  lastName          String
  dob               DateTime
  phone             String?
  status            StudentStatus @default(ACTIVE)
  // The day the student joined the center -- their own monthly payment day (packages/shared billing.ts).
  joinedAt          DateTime      @default(now())
  // When a payment reminder was last sent to their Telegram chats.
  paymentRemindedAt DateTime?
  userId            String?       @unique
  user              User?         @relation(fields: [userId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  enrollments         Enrollment[]
  telegramLinks       TelegramLink[]
  linkingCodes        LinkingCode[]
  quizAttempts        QuizAttempt[]
  attendances         Attendance[]
  homeworkResults     HomeworkResult[]
  homeworkSubmissions HomeworkSubmission[]
  assessmentResults   AssessmentResult[]
  payments            Payment[]
  pointTransactions   PointTransaction[]
  conversation        Conversation?

  @@map("students")
}

model Teacher {
  id        String   @id @default(cuid())
  fullName  String
  // Shown to students in the Mini App, with a button that calls it.
  phone     String?
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups         Group[]
  lessonSessions LessonSession[]

  @@map("teachers")
}

// A code an admin issues for one Student. Anyone holding it -- the student or
// a parent -- can redeem it from their own Telegram account until it expires,
// so it is deliberately reusable rather than one-time.
model LinkingCode {
  code      String   @id
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issuedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([studentId])
  @@map("linking_codes")
}

// One Telegram chat bound to the Student it may view. A student and their
// parents each link their own chat to the same Student; a chat views exactly
// one Student at a time (redeeming another code re-points it).
model TelegramLink {
  chatId    String   @id
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  linkedAt  DateTime @default(now())

  @@index([studentId])
  @@map("telegram_links")
}

model Subject {
  id      String   @id @default(cuid())
  name    String   @unique
  courses Course[]

  enrollments Enrollment[]

  @@map("subjects")
}

model Course {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  name      String
  levels    Level[]

  @@unique([subjectId, name])
  @@map("courses")
}

model Level {
  id       String  @id @default(cuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id])
  name     String
  // "#rrggbb", picked at creation so no two levels share a color -- groups,
  // timetables and the Mini App paint a level's groups in it.
  color    String
  groups   Group[]

  assessmentCategories AssessmentCategory[]

  @@unique([courseId, name])
  @@map("levels")
}

// A configurable skill/grading dimension scoped to a Level (§18/§43). Once
// referenced by any Assessment, a category is retired rather than edited or
// deleted, so historical reports keep the category set active at the time
// they were produced (ADR: see docs/DOMAIN-MODEL.md §51.2).
model AssessmentCategory {
  id          String                    @id @default(cuid())
  levelId     String
  level       Level                     @relation(fields: [levelId], references: [id])
  name        String
  // The category's grading scale, set once at curriculum-creation time (e.g.
  // 100 for a percentage skill like Speaking, 5 for a 0-5 scale like
  // Homework) -- an Assessment normally inherits this rather than the
  // teacher re-typing it every time (§18/§43/§51.1).
  maxScore    Int                       @default(100)
  // How many Rating points a 100% result in this category is worth, set once
  // alongside maxScore at curriculum-creation time. 0 (the default) means this
  // category doesn't feed the Rating ledger at all -- an admin opts a category
  // in by giving it a positive value.
  pointsWorth Int                       @default(0)
  // DAILY categories auto-show as a gradeable column every lesson day.
  // WEEKLY/MONTHLY ones only appear when a teacher opens that period's round.
  cadence     AssessmentCategoryCadence @default(DAILY)
  retiredAt   DateTime?
  createdAt   DateTime                  @default(now())

  assessments Assessment[]

  @@unique([levelId, name])
  @@map("assessment_categories")
}

model Group {
  id                        String      @id @default(cuid())
  levelId                   String
  level                     Level       @relation(fields: [levelId], references: [id])
  teacherId                 String
  teacher                   Teacher     @relation(fields: [teacherId], references: [id])
  name                      String
  scheduleDays              String[]
  scheduleTime              String
  startDate                 DateTime
  // The monthly course fee, in so'm -- what a payment defaults to. 0 means it hasn't been set.
  // Payments fall due every month on startDate's day of the month.
  monthlyFee                Int         @default(0)
  // Lets the group's students hand in homework as photos through Telegram (off for most groups).
  homeworkSubmissionEnabled Boolean     @default(false)
  status                    GroupStatus @default(ACTIVE)
  // Set when an admin deletes the group. It is archived, never removed: its
  // past lessons, marks and points stay as history (see archiveGroup).
  archivedAt                DateTime?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  enrollments       Enrollment[]
  lessonSessions    LessonSession[]
  assessments       Assessment[]
  pointTransactions PointTransaction[]
  reschedules       LessonReschedule[]
  homeworkImages    HomeworkImage[]

  @@map("groups")
}

// Time-bounded membership of a Student in a Group. `subjectId` is denormalized
// from group.level.course.subject purely to support the partial unique index
// (added in a follow-up migration) enforcing one active enrollment per subject.
model Enrollment {
  id        String               @id @default(cuid())
  studentId String
  student   Student              @relation(fields: [studentId], references: [id])
  groupId   String
  group     Group                @relation(fields: [groupId], references: [id])
  subjectId String
  subject   Subject              @relation(fields: [subjectId], references: [id])
  startDate DateTime
  endDate   DateTime?
  status    EnrollmentStatus     @default(ACTIVE)
  endReason EnrollmentEndReason?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([studentId])
  @@index([groupId])
  @@map("enrollments")
}

// One actual, dated occurrence of a Group meeting (CONTEXT.md: LessonSession).
// One per (group, date) -- the teacher's single "save the lesson" action
// (requirements §29) upserts this row plus its materials/homework/attendance.
model LessonSession {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  date      DateTime
  topic     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materials   LessonMaterial[]
  homework    Homework?
  attendances Attendance[]
  quizzes     Quiz[]

  @@unique([groupId, date])
  @@map("lesson_sessions")
}

model LessonMaterial {
  id              String             @id @default(cuid())
  lessonSessionId String
  lessonSession   LessonSession      @relation(fields: [lessonSessionId], references: [id])
  type            LessonMaterialType
  content         String
  createdAt       DateTime           @default(now())

  @@map("lesson_materials")
}

// The instructions a Teacher records against a LessonSession. Usually checked
// in class; in groups with `homeworkSubmissionEnabled`, students may also hand
// it in as photos through Telegram (HomeworkSubmission).
model Homework {
  id              String        @id @default(cuid())
  lessonSessionId String        @unique
  lessonSession   LessonSession @relation(fields: [lessonSessionId], references: [id])
  instructions    String
  dueDate         DateTime?
  createdAt       DateTime      @default(now())

  results     HomeworkResult[]
  submissions HomeworkSubmission[]
  images      HomeworkImage[]

  @@map("homeworks")
}

// A picture the teacher hands out with a Homework -- a worksheet, a page of the
// book. Each one is a task of its own: an optional title ("Listening",
// "Vocabulary"), caption and deadline. Stored on Telegram like HomeworkPhoto
// (only file ids here). It is uploaded before the lesson is saved, so it starts
// with no `homeworkId` (`groupId` says whose it is meanwhile) and the lesson
// save attaches it.
model HomeworkImage {
  id                   String    @id @default(cuid())
  groupId              String
  group                Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  homeworkId           String?
  homework             Homework? @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  title                String?
  caption              String?
  // The moment this task is due (day and time) -- unlike Homework.dueDate, a calendar day.
  dueDate              DateTime?
  // Where it sits among the homework's images, from 0.
  position             Int       @default(0)
  telegramFileId       String
  telegramFileUniqueId String
  width                Int?
  height               Int?
  size                 Int?
  createdAt            DateTime  @default(now())

  @@index([homeworkId])
  @@map("homework_images")
}

// One student's photos for one Homework. The photos themselves live on
// Telegram's servers -- only their file ids are stored here (see
// apps/server/src/telegram/fileStore.ts).
model HomeworkSubmission {
  id             String                   @id @default(cuid())
  homeworkId     String
  homework       Homework                 @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         HomeworkSubmissionStatus @default(SUBMITTED)
  // When a photo was last added -- "late" compares it with the homework's due date.
  submittedAt    DateTime                 @default(now())
  checkedAt      DateTime?
  teacherComment String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  photos HomeworkPhoto[]

  @@unique([homeworkId, studentId])
  @@index([submittedAt])
  @@map("homework_submissions")
}

model HomeworkPhoto {
  id                   String             @id @default(cuid())
  submissionId         String
  submission           HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  // Telegram's id for downloading the file again (see HomeworkSubmission).
  telegramFileId       String
  telegramFileUniqueId String
  width                Int?
  height               Int?
  size                 Int?
  createdAt            DateTime           @default(now())

  @@index([submissionId])
  @@map("homework_photos")
}

// A completion status is always required; `score` is optional and, when
// absent, the entry is excluded from homework-performance averages (§51.1).
model HomeworkResult {
  id             String               @id @default(cuid())
  homeworkId     String
  homework       Homework             @relation(fields: [homeworkId], references: [id])
  studentId      String
  student        Student              @relation(fields: [studentId], references: [id])
  status         HomeworkResultStatus
  score          Int?
  teacherComment String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([homeworkId, studentId])
  @@map("homework_results")
}

// Present/Late credit fully, Absent credits nothing, Excused is removed from
// the denominator entirely when computing attendance % (§51.1).
model Attendance {
  id                String           @id @default(cuid())
  lessonSessionId   String
  lessonSession     LessonSession    @relation(fields: [lessonSessionId], references: [id])
  studentId         String
  student           Student          @relation(fields: [studentId], references: [id])
  status            AttendanceStatus
  // When the student's chats were told they missed this lesson -- null until someone presses the button.
  absenceNotifiedAt DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([lessonSessionId, studentId])
  @@map("attendances")
}

// A single-category, Teacher-created grading event for a Group on a date.
// A "Monthly Assessment" spanning several categories is several Assessment
// rows sharing (title, type, date, group) -- see ADR-0001.
model Assessment {
  id             String             @id @default(cuid())
  groupId        String
  group          Group              @relation(fields: [groupId], references: [id])
  categoryId     String
  category       AssessmentCategory @relation(fields: [categoryId], references: [id])
  title          String
  type           AssessmentType
  date           DateTime
  maxScore       Int
  teacherComment String?
  createdAt      DateTime           @default(now())

  results AssessmentResult[]

  // Lets the server upsert on (group, category, date, title) -- the same
  // "editing a cell either creates or updates today's row" pattern
  // recordLessonSession already uses for (group, date).
  @@unique([groupId, categoryId, date, title])
  @@map("assessments")
}

model AssessmentResult {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  score        Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  pointTransaction PointTransaction?

  @@unique([assessmentId, studentId])
  @@map("assessment_results")
}

// Monthly subscription billing (§27/§51.4) -- one row per (Student, calendar
// month). `status` is always re-derived from amountDue/amountPaid rather than
// set independently, so it can never drift out of sync with the amounts.
model Payment {
  id               String        @id @default(cuid())
  studentId        String
  student          Student       @relation(fields: [studentId], references: [id])
  year             Int
  month            Int
  amountDue        Int
  amountPaid       Int           @default(0)
  status           PaymentStatus @default(DEBT)
  paidAt           DateTime?
  recordedByUserId String
  note             String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([studentId, year, month])
  @@index([studentId])
  @@map("payments")
}

// Append-only points ledger entry (§11/§51.3) -- never edited or deleted,
// always tagged with the Group active when the points were earned so a
// group's leaderboard only ever sums transactions tagged to that Group.
model PointTransaction {
  id           String            @id @default(cuid())
  studentId    String
  student      Student           @relation(fields: [studentId], references: [id])
  groupId      String
  group        Group             @relation(fields: [groupId], references: [id])
  activityType PointActivityType
  points       Float
  note         String?
  createdAt    DateTime          @default(now())

  // Set only when this row is derived from an AssessmentResult (a category
  // with pointsWorth > 0). That row is upserted whenever the result is
  // (re)graded, so it always mirrors the current score -- unlike a manual
  // award, which stays append-only and is corrected by appending a new entry
  // (§51.3).
  assessmentResultId String?           @unique
  assessmentResult   AssessmentResult? @relation(fields: [assessmentResultId], references: [id])

  // Set only when this row is the points a completed QuizAttempt earned.
  quizAttemptId String?      @unique
  quizAttempt   QuizAttempt? @relation(fields: [quizAttemptId], references: [id])

  @@index([studentId])
  @@index([groupId])
  @@map("point_transactions")
}

// A quiz a teacher writes inside one lesson and sends to that lesson's group
// through Telegram -- see docs/adr/0003-quiz-belongs-to-lesson-session.md.
model Quiz {
  id              String        @id @default(cuid())
  lessonSessionId String
  lessonSession   LessonSession @relation(fields: [lessonSessionId], references: [id])
  title           String
  // Points for a fully correct attempt; a partial one earns the same share.
  maxPoints       Int
  status          QuizStatus    @default(DRAFT)
  sentAt          DateTime?
  deadline        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([lessonSessionId])
  @@map("quizzes")
}

model QuizQuestion {
  id       String @id @default(cuid())
  quizId   String
  quiz     Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  position Int
  text     String

  options QuizOption[]
  answers QuizAnswer[]

  @@unique([quizId, position])
  @@map("quiz_questions")
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int
  text       String
  isCorrect  Boolean

  answers QuizAnswer[]

  @@unique([questionId, position])
  @@map("quiz_options")
}

// One per (quiz, student) -- the single, non-retakeable attempt.
model QuizAttempt {
  id           String    @id @default(cuid())
  quizId       String
  quiz         Quiz      @relation(fields: [quizId], references: [id])
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id])
  startedAt    DateTime  @default(now())
  // Set together when the attempt is scored (all answered, or the deadline passed).
  completedAt  DateTime?
  correctCount Int?
  points       Float?

  answers          QuizAnswer[]
  pointTransaction PointTransaction?

  @@unique([quizId, studentId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id         String       @id @default(cuid())
  attemptId  String
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id])
  optionId   String
  option     QuizOption   @relation(fields: [optionId], references: [id])
  isCorrect  Boolean
  answeredAt DateTime     @default(now())

  @@unique([attemptId, questionId])
  @@map("quiz_answers")
}

// One regular lesson moved to another day and/or time (a holiday, an event):
// the group does not meet on `originalDate` and meets on `newDate` at
// `newTime` instead. Dates are calendar days stored as UTC midnight, the same
// convention as LessonSession.date.
model LessonReschedule {
  id           String    @id @default(cuid())
  groupId      String
  group        Group     @relation(fields: [groupId], references: [id])
  originalDate DateTime
  newDate      DateTime
  newTime      String
  reason       String?
  // Last time the group's Telegram chats were told about this change.
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([groupId, originalDate])
  @@index([newDate])
  @@map("lesson_reschedules")
}

// The one message thread between a Student's family (every Telegram chat
// linked to the Student) and staff -- "O'qituvchi bilan muloqot". Created on
// the first message from either side.
model Conversation {
  id                  String    @id @default(cuid())
  studentId           String    @unique
  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lastMessageAt       DateTime  @default(now())
  // The newest family message -- a conversation is unread for a staff member
  // while this is later than their ConversationRead.readAt.
  lastFamilyMessageAt DateTime?
  // When the family last opened the thread in the Mini App (or wrote in it) --
  // staff messages up to then are shown as seen.
  familyReadAt        DateTime?
  createdAt           DateTime  @default(now())

  messages ChatMessage[]
  reads    ConversationRead[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         ChatSender
  text           String
  // FAMILY: the Telegram chat it came from and that account's name.
  // STAFF: the user who wrote it and their name (the teacher's full name, or "Administrator").
  senderChatId   String?
  senderUserId   String?
  senderUser     User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  senderName     String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// How far one staff member has read a conversation. Per user, so an admin
// reading a thread doesn't hide it from the group's teacher.
model ConversationRead {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime

  @@id([conversationId, userId])
  @@map("conversation_reads")
}
