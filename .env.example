# HTTPS URL of the student Telegram Mini App (admin-web's /student). Defaults to production.
# Telegram only opens HTTPS URLs -- for local testing use a tunnel (e.g. cloudflared) to :5173.
MINI_APP_URL="https://umid-edu.up.railway.app/student"
