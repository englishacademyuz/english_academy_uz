JWT_SECRET="change-me-in-production"
PORT=3000
TELEGRAM_BOT_TOKEN=""
# Optional: a private channel (bot as admin, id starts with -100) that keeps a copy of every
# homework photo. Without it, Mini App uploads are posted in the uploader's own chat with the bot.
